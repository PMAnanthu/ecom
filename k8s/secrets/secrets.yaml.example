# k8s/secrets/secrets.yaml — GITIGNORED, apply manually
# Create with: kubectl apply -f k8s/secrets/secrets.yaml
#
# Generate base64: echo -n 'value' | base64
apiVersion: v1
kind: Secret
metadata:
  name: ecom-secrets
  namespace: ecom
type: Opaque
data:
  DATABASE_URL: <base64-encoded-postgres-url>
  JWT_SECRET: <base64-encoded-jwt-secret>
  JWT_REFRESH_SECRET: <base64-encoded-refresh-secret>
