# Copy this to .env.cloudrun and fill in your values
# NEVER commit .env.cloudrun to git

# Your GCP project ID (get with: gcloud config get project)
GCP_PROJECT=your-project-id

# Region — asia-south1 is Mumbai (closest to Kerala, cheapest in Asia)
GCP_REGION=asia-south1

# Neon Postgres (free tier) — get from neon.tech
# Format: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Upstash Redis (free tier) — get from upstash.com
# Format: redis://:password@host:port
REDIS_URL=redis://:password@global-xxxx.upstash.io:6379

# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_generate_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=change_me_generate_with_openssl_rand_hex_32
