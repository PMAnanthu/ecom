generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth_svc"]
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  role           Role      @default(USER)
  storeId        String?
  subscriptionId String?
  blocked        Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@schema("auth_svc")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  name      String
  line1     String
  city      String
  country   String
  zip       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  @@schema("auth_svc")
}

enum Role {
  SUPERADMIN
  ADMIN
  USER
  @@schema("auth_svc")
}
