{
  "name": "ecom-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:pdf": "playwright test && open test-results/$(ls -t test-results/*.pdf | head -1)"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6"
  },
  "dependencies": {
    "pdfkit": "^0.19.1"
  }
}
