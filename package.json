{
  "name": "ecom",
  "version": "0.2.1",
  "description": "SaaS e-commerce platform — multi-tenant, microservice, PWA",
  "private": true,
  "workspaces": [
    "services/*",
    "ui/platform-ui",
    "ui/storefront"
  ],
  "scripts": {
    "start": "./start.sh",
    "dev:ui": "cd ui/platform-ui && npm run dev -- --port 3100",
    "dev:storefront": "cd ui/storefront && npm run dev -- --port 3200 --webpack",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
